{
  "name": "ffmpeg-resizer",
  "version": "2.0.0",
  "description":" An Express server that resizes images and videos using ffmpeg and uploads them to Cloudinary.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "sudo apt install ffmpeg -y"
  },
  "keywords": ["express", "ffmpeg", "cloudinary", "image resizing", "video resizing"],
  "author": "Ricky and Shangzhe",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.7.0",
    "dotenv": "^17.2.1",
    "multer": "^2.0.2",
    "@aws-sdk/client-cognito-identity-provider": "^3.637.0",
    "@aws-sdk/client-dynamodb": "^3.637.0",
    "@aws-sdk/util-dynamodb": "^3.637.0",
    "@aws-sdk/lib-dynamodb": "^3.637.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@aws-sdk/lib-storage": "^3.637.0",
    "aws-jwt-verify": "^4.0.1",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "mime-types": "^2.1.35",
    "openid-client": "^5.7.0",
    "ffmpeg-static": "^5.1.0"
  }
}